*.sh   text eol=lf
*.py   text eol=lf
customize.sh    text eol=lf
config.sh       text eol=lf
update-binary   text eol=lf
updater-script  text eol=lf
system/bin/*    text eol=lf
lib/**          text eol=lf
scripts/**      text eol=lf
META-INF/**     text eol=lf
