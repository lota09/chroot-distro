#!/system/bin/sh
# chd (chroot-distro rb2) - thin entry. Sources lib modules and dispatches.
# Heavy logic lives in $CHD_ROOT/lib/*.sh (one concern per file).

: "${CHROOT_DISTRO_PATH:=/data/local/chroot-distro}"
CHD_ROOT="$CHROOT_DISTRO_PATH"
CHD_LIB="$CHD_ROOT/lib"
CHD_SCRIPTS="$CHD_ROOT/scripts"
export CHD_ROOT CHD_LIB CHD_SCRIPTS

if [ ! -f "$CHD_LIB/util.sh" ]; then
    echo "[chd][ERROR] library not found at $CHD_LIB - reinstall the module." >&2
    exit 1
fi

for _m in util mount image jail download profile supervisor services instance backup debug; do
    [ -f "$CHD_LIB/$_m.sh" ] && . "$CHD_LIB/$_m.sh"
done
# Enforce busybox tar/wget/sort (Android toybox tar can't do xz; no wget).
command -v chd_setup_busybox >/dev/null 2>&1 && chd_setup_busybox
[ -f "$CHD_LIB/distro/common.sh" ] && . "$CHD_LIB/distro/common.sh"
for _d in "$CHD_LIB"/distro/*.sh; do
    case "$_d" in *"/common.sh") continue ;; esac
    [ -f "$_d" ] && . "$_d"
done

chd_usage() {
    cat <<USAGE
chd (chroot-distro rb2) $CHD_VERSION
Usage: chd <command> [args]

  help                          this help
  version                       print version
  debug                         environment diagnostics
  list                          profiles & instances (tree)
  profile [name]                create/edit a profile (wizard, numbered menus)
  install [--no-init] [--no-img] <profile>
                                install an instance from a profile template
  login <name>                  enter an instance (mount + services + root shell)
  command <name> "<cmd>"        run a command inside an instance
  mount <name>                  mount only (image + system points), no shell
  unmount <name|all> [-f]       unmount (-f: kill holders first)
  uninstall <name> [-f] [--include-profile]
                                delete ONE instance (+ its .img). template kept
  backup [name] [path]          create/manage backups (restore & delete inside)
  rename <old> <new>            rename an instance
USAGE
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift

case "$cmd" in
    help|--help|-h)        chd_usage ;;
    version|--version|-v)  echo "chd $CHD_VERSION" ;;
    debug)                 chd_dispatch chd_cmd_debug     "$@" ;;
    list)                  chd_dispatch chd_cmd_list      "$@" ;;
    profile)               chd_dispatch chd_cmd_profile   "$@" ;;
    install)
        mkdir -p "$CHD_ROOT/log"
        _ts="$(date +%Y%m%d-%H%M%S 2>/dev/null || echo now)"
        _ilog="$CHD_ROOT/log/install-$_ts.log"
        # Capture the ENTIRE install (host + guest apt init) to a file, and still
        # show it live. tee runs the command in a subshell, which is fine here.
        chd_dispatch chd_cmd_install "$@" 2>&1 | tee "$_ilog"
        _irc=$?
        ln -sf "install-$_ts.log" "$CHD_ROOT/log/install-latest.log" 2>/dev/null
        printf '[chd] full install log saved: %s\n' "$_ilog" >&2
        exit "$_irc"
        ;;
    login)                 chd_dispatch chd_cmd_login     "$@" ;;
    command)               chd_dispatch chd_cmd_command   "$@" ;;
    mount)                 chd_dispatch chd_cmd_mount     "$@" ;;
    unmount)               chd_dispatch chd_cmd_unmount   "$@" ;;
    uninstall)             chd_dispatch chd_cmd_uninstall "$@" ;;
    backup)                chd_dispatch chd_cmd_backup    "$@" ;;
    rename)                chd_dispatch chd_cmd_rename    "$@" ;;
    *) print_message error "unknown command: $cmd"; chd_usage; exit 1 ;;
esac
